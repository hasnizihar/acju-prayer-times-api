{
  "version": 2,
  "builds": [
    {
      "src": "api/app.js",
      "use": "@vercel/node"
    },
    {
      "src": "acju-prayer-times-docs/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/app.js"
    }
  ]
}
