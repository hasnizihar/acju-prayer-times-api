  "scripts": {
    "test": "jest",
    "build": "cd acju-prayer-times-docs && npm run build",
    "start": "node api/server.js",
    "dev": "node --watch-path=./api api/server.js"
  },
  "keywords": [
    "prayer-times",
    "acju",
    "sri-lanka",
    "islamic",
    "islamic-prayer",
    "salah",
    "namaz",
    "api",
    "rest-api",
    "express",
    "supabase",
    "nodejs",
    "geolocation",
    "gps",
    "openapi"
  ],
  "author": "KR Hasni Zihar",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "cors": "^2.8.6",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fumadocs-core": "^16.15.1",
    "fumadocs-mdx": "^15.3.1",
    "next": "^16.3.3",
    "pdf-parse": "^2.4.5",
